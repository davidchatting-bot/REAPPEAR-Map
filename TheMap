#!/bin/sh

APPDIR=$(readlink -f "$0")
APPDIR=$(dirname "$APPDIR")
# lib/* picks up every jar in lib/, including whichever platform's JOGL/GlueGen
# natives jars are present - nothing here names a specific platform.
java -Djna.nosys=true -Djava.library.path="$APPDIR:$APPDIR/lib" -cp "$APPDIR:$APPDIR/lib/*" TheMap "$@"
